# 在官方镜像基础上叠加本次改动，用于云服务器部署
#
# 本地开发时是用 volumes 把改动文件挂进容器的；服务器上更推荐直接构建一个带改动的镜像，
# 这样容器不依赖宿主机上的源码目录，重启、迁移都不会丢改动。
#
# 构建：docker build -f Dockerfile.patch -t maxkb-patched:v2.10.6-lts .
FROM 1panel/maxkb:v2.10.6-lts

# 1) PDF 标题识别修复（中文公文标题与正文同字号时按文本特征补标题标记）
COPY apps/common/handle/impl/text/pdf_split_handle.py /opt/maxkb-app/apps/common/handle/impl/text/pdf_split_handle.py

# 2) 扫描版 PDF 的 OCR 兜底模块（被上面那个文件 import）
COPY apps/common/handle/impl/text/pdf_ocr_helper.py /opt/maxkb-app/apps/common/handle/impl/text/pdf_ocr_helper.py
